@startuml product-list-presentation-class
' 商品一覧（ProductList）プレゼンテーション層のクラス図
' UI ──Intent──▶ Processor ──Action──▶ Reducer ──State──▶ UI
'                   └──SideEffect──▶ UI

title ProductList プレゼンテーション層（クラス図）

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
hide empty members

' ===== Android =====
package "androidApp（Android）" as android #E8F5E9 {
  class ProductListViewModel <<ViewModel>> {
    - store : ProductListStore
    + state : StateFlow<ProductListUiState>
    + sideEffect : Flow<ProductListSideEffect>
    + dispatch(intent : ProductListIntent)
  }
  class "ProductListRoute / ProductListScreen" as AndroidScreen <<Composable>>
}

' ===== iOS =====
package "iosApp（iOS / SwiftUI）" as ios #E3F2FD {
  class ProductListObservable <<ObservableObject>> {
    + state : ProductListUiState <<@Published>>
    + navigateToDetailId : String? <<@Published>>
    - store : ProductListStore
    + observe() async
    + load()
    + clickProduct(id : String)
    - handle(effect : ProductListSideEffect)
  }
  class ProductListView <<View>>
}

' ===== shared =====
package "shared / commonMain" as shared #FFF8E1 {

  package "di" {
    class KmpSdk <<object>> {
      + initialize()
      + getProductsUseCase() : GetProductsUseCase
      + createProductListStore(scope : CoroutineScope) : ProductListStore
      + createProductListStore() : ProductListStore
    }
  }

  package "domain" {
    class GetProductsUseCase {
      + invoke() : DomainResult<List<Product>> <<suspend>>
    }
  }

  package "presentation" {

    package "intent" {
      interface ProductListIntent <<sealed>>
      class "Load" as IntentLoad <<data object>>
      class "ClickProduct" as IntentClick <<data class>> {
        + id : String
      }
      ProductListIntent <|.. IntentLoad
      ProductListIntent <|.. IntentClick
    }

    package "action" {
      interface ProductListAction <<sealed, internal>>
      class LoadStarted <<data object>>
      class LoadSucceeded <<data class>> {
        + products : List<Product>
      }
      class LoadFailed <<data class>> {
        + message : String
      }
      ProductListAction <|.. LoadStarted
      ProductListAction <|.. LoadSucceeded
      ProductListAction <|.. LoadFailed
    }

    package "state" {
      class ProductListUiState <<data class>> {
        + isLoading : Boolean
        + products : List<Product>
        + errorMessage : String?
      }
    }

    package "sideEffect" {
      interface ProductListSideEffect <<sealed>>
      class NavigateToDetail <<data class>> {
        + id : String
      }
      ProductListSideEffect <|.. NavigateToDetail
    }

    package "processor" {
      interface "Processor<Intent, Action, SideEffect>" as Processor <<fun interface, internal>> {
        + process(intent : Intent) : Flow<ProcessorOutput<Action, SideEffect>>
      }
      interface "ProcessorOutput<Action, SideEffect>" as ProcessorOutput <<sealed, internal>>
      class "ProcessorOutput.Action" as OutAction {
        + action : Action
      }
      class "ProcessorOutput.SideEffect" as OutSideEffect {
        + sideEffect : SideEffect
      }
      ProcessorOutput <|.. OutAction
      ProcessorOutput <|.. OutSideEffect

      class ProductListProcessor <<internal>> {
        - getProducts : GetProductsUseCase
        + process(intent : ProductListIntent) : Flow<ProcessorOutput<...>>
      }
      Processor <|.. ProductListProcessor
    }

    package "reducer" {
      interface "Reducer<State, Action>" as Reducer <<fun interface, internal>> {
        + reduce(state : State, action : Action) : State
      }
      class ProductListReducer <<object, internal>> {
        + reduce(state : ProductListUiState, action : ProductListAction) : ProductListUiState
      }
      Reducer <|.. ProductListReducer
    }

    package "store" {
      class "Store<Intent, Action, State, SideEffect>" as Store <<internal>> {
        - _state : MutableStateFlow<State>
        - _sideEffect : Channel<SideEffect>
        - processor : Processor
        - reducer : Reducer
        - scope : CoroutineScope
        + state : StateFlow<State>
        + sideEffect : Flow<SideEffect>
        + dispatch(intent : Intent)
        + close()
      }

      class ProductListStore {
        - store : Store<ProductListIntent, ProductListAction, ProductListUiState, ProductListSideEffect>
        + state : StateFlow<ProductListUiState>
        + sideEffect : Flow<ProductListSideEffect>
        + dispatch(intent : ProductListIntent)
        + close()
      }

      class "storeScope()" as StoreScope <<internal function>> {
        SupervisorJob() + Dispatchers.Main.immediate
      }
    }
  }
}

' ===== 関係 =====
' 画面ごとの Store は汎用 Store に処理を任せる（Action を internal に閉じるため継承ではなく委譲）
ProductListStore *-- Store : 委譲
Store o-- Processor
Store o-- Reducer
Store ..> ProcessorOutput : collect

ProductListStore ..> ProductListProcessor : 生成
ProductListStore ..> ProductListReducer : 使用
ProductListProcessor --> GetProductsUseCase
ProductListProcessor ..> ProductListIntent : 受け取る
ProductListProcessor ..> ProductListAction : 出す
ProductListProcessor ..> ProductListSideEffect : 出す
ProductListReducer ..> ProductListUiState : 作る

KmpSdk ..> ProductListStore : 生成
KmpSdk ..> StoreScope : iOS 用の scope

' Android
AndroidScreen --> ProductListViewModel
ProductListViewModel *-- ProductListStore : viewModelScope で保持
ProductListViewModel ..> KmpSdk

' iOS
ProductListView --> ProductListObservable
ProductListObservable *-- ProductListStore : deinit で close()
ProductListObservable ..> KmpSdk

note right of ProductListStore
  Android / iOS の両方に公開する唯一の Store。
  型を具体的に書いているのは、SKIE が Swift で
  StateFlow<ProductListUiState> を AsyncSequence として
  そのまま扱えるようにするため。
end note

note bottom of ProductListReducer
  副作用のない純粋関数。
  State + Action → 次の State
end note

@enduml
